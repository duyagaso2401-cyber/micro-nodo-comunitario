# ==========================================================
# Micro-Nodo Comunitario - Variables de entorno (Fase 1 + Fase 2)
# Copiar este archivo a ".env" y ajustar valores locales.
#
# Este mismo archivo sirve para dos escenarios de despliegue distintos:
#   A) Mini PC / Raspberry Pi / TV Box sirviendo por HTTP plano en la red
#      Wi-Fi local (el uso principal del proyecto).
#   B) Un servicio en la nube como Render/Railway (por ejemplo, para tener
#      el backend central de administración, o para probar el panel
#      /admin sin hardware físico). Las líneas marcadas "[Render]" abajo
#      son las que cambian entre un escenario y otro.
# ==========================================================

# --- Servidor ---
# [Render] Render inyecta PORT automáticamente (ya lo tienes configurado en
# 10000) y también define NODE_ENV=production por su cuenta — no hace falta
# que los dupliques a mano en el .env si ya los pusiste en su pestaña
# "Environment"; este archivo es solo la referencia de qué existe.
PORT=3000
NODE_ENV=production

# --- Identidad del nodo ---
# NODO_ID identifica a ESTE nodo en la base de datos central (tabla
# `nodos`). Si vas a tener más de un nodo hablándole a la misma central,
# cada uno necesita un NODO_ID único.
NODO_ID=nodo-001
NODO_NOMBRE="Punto Comunitario de Internet Hibrido - Sede 1"
NODO_UBICACION="Ej: Tienda La Esquina, Barrio Centro"

# --- Base de datos local (SQLite) ---
# [Render] Sin un "Persistent Disk" adjunto al servicio, todo lo que se
# escribe aquí (la base de datos, los contenidos descargados, las imágenes
# de anuncios subidas) se BORRA en cada redeploy o reinicio del contenedor
# — el disco es efímero. Si te importa conservar esos datos entre deploys,
# agrega un Persistent Disk en Render (por ejemplo montado en /var/data) y
# apunta DB_PATH / DOWNLOADS_PATH / UPLOADS_ANUNCIOS_PATH dentro de él.
DB_PATH=./data/nodo-local.sqlite3

# --- Almacenamiento de contenidos descargados ---
DOWNLOADS_PATH=./data/downloads
DISCO_LIMITE_MB=8192
DISCO_UMBRAL_LIMPIEZA_PCT=85

# --- Worker de sincronización de contenido (Fase 1) ---
SYNC_CRON_EXPRESION="0 2 * * *"
SYNC_FUENTE_GUTENDEX_URL=https://gutendex.com/books
SYNC_MAX_DESCARGAS_POR_CICLO=15
SYNC_HABILITADO=true

# --- Monetización / PINs ---
PIN_LONGITUD=6
PIN_COMISION_LOCAL_PCT=20
PIN_VALOR_DEFECTO_COP=2000

# --- Clave de administración por header (retrocompatibilidad con Fase 1;
#     el panel /admin de Fase 2 usa usuario/contraseña, ver más abajo) ---
ADMIN_API_KEY=cambia-esta-clave-en-produccion

# ==========================================================
# Fase 2
# ==========================================================

# --- Backend central (Neon PostgreSQL / Supabase) ---
# CENTRAL_DATABASE_URL es la cadena de conexión que te da Neon/Supabase,
# algo como:
#   postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
# Déjala vacía para operar 100% offline: el nodo funciona igual, solo que
# no sincroniza transacciones ni envía telemetría a ningún lado.
CENTRAL_DATABASE_URL=
CENTRAL_SYNC_HABILITADO=true
CENTRAL_SYNC_CRON_EXPRESION="*/10 * * * *"
CENTRAL_SYNC_LOTE_MAX=50

# --- Telemetría / heartbeat hacia la central ---
TELEMETRY_HABILITADO=true
TELEMETRY_INTERVALO_MIN=5

# --- Panel de administración /admin (sesión con cookie) ---
# [Render] Define un SESSION_SECRET propio y largo (no el valor de
# ejemplo) — es lo que firma la cookie de sesión del panel.
SESSION_SECRET=cambia-este-secreto-de-sesion-en-produccion
SESSION_MAX_EDAD_HORAS=12
# Usuario/contraseña del admin inicial. Solo se usan la PRIMERA vez que se
# corre "npm run db:migrate" (si la tabla admins ya tiene un usuario, no se
# vuelven a aplicar). Cambia la contraseña desde el panel después de entrar.
ADMIN_USUARIO=admin
ADMIN_PASSWORD_INICIAL=cambiar123
# [Render] Ponla en "true" cuando el nodo se sirve detrás de un proxy que
# termina TLS (Render, Railway, nginx con certificado) — hace que la
# cookie de sesión exija HTTPS de verdad. Déjala en "false" para el
# despliegue típico offline-first (Mini PC/RPi por HTTP plano en la red
# local): con "true" ahí el login del panel dejaría de funcionar.
COOKIE_SEGURA=false

# --- Publicidad local ---
UPLOADS_ANUNCIOS_PATH=./public/uploads/anuncios
ANUNCIO_DURACION_SEGUNDOS=5
