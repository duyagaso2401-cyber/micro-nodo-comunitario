# ==========================================================
# Micro-Nodo Comunitario - Variables de entorno (Fase 1)
# Copiar este archivo a ".env" y ajustar valores locales
# ==========================================================

# --- Servidor local ---
PORT=3000
NODE_ENV=production

# --- Identidad del nodo ---
NODO_ID=nodo-001
NODO_NOMBRE="Punto Comunitario de Internet Hibrido - Sede 1"
NODO_UBICACION="Ej: Tienda La Esquina, Barrio Centro"

# --- Base de datos ---
DB_PATH=./data/nodo-local.sqlite3

# --- Almacenamiento de contenidos descargados ---
DOWNLOADS_PATH=./data/downloads
DISCO_LIMITE_MB=8192
DISCO_UMBRAL_LIMPIEZA_PCT=85

# --- Worker de sincronización ---
SYNC_CRON_EXPRESION="0 2 * * *"
SYNC_FUENTE_GUTENDEX_URL=https://gutendex.com/books
SYNC_MAX_DESCARGAS_POR_CICLO=15
SYNC_HABILITADO=true

# --- Monetización / PINs ---
PIN_LONGITUD=6
PIN_COMISION_LOCAL_PCT=20
PIN_VALOR_DEFECTO_COP=2000

# --- Clave simple de administración (Fase 1, reemplazar por auth real en Fase 2) ---
ADMIN_API_KEY=cambia-esta-clave-en-produccion

# --- Telemetria remota (Fase 2 - aun no implementado, dejar preparado) ---
TELEMETRY_HABILITADO=false
TELEMETRY_ENDPOINT_URL=
TELEMETRY_INTERVALO_MIN=15
